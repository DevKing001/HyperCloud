#!/bin/bash
    set -euo pipefail
    
    clear
    cat << "EOF"
       ===================================================================
██╗  ██╗██╗   ██╗██████╗ ███████╗██████╗  ██████╗██╗      ██████╗ ██╗   ██╗██████╗
██║  ██║╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗██╔════╝██║     ██╔═══██╗██║   ██║██╔══██╗
███████║ ╚████╔╝ ██████╔╝█████╗  ██████╔╝██║     ██║     ██║   ██║██║   ██║██║  ██║
██╔══██║  ╚██╔╝  ██╔═══╝ ██╔══╝  ██╔══██╗██║     ██║     ██║   ██║██║   ██║██║  ██║
██║  ██║   ██║   ██║     ███████╗██║  ██║╚██████╗███████╗╚██████╔╝╚██████╔╝██████╔╝
╚═╝  ╚═╝   ╚═╝   ╚═╝     ╚══════╝╚═╝  ╚═╝ ╚═════╝╚══════╝ ╚═════╝  ╚═════╝ ╚═════╝
                POWERED BY HyperCloud
       ===================================================================
EOF
    
    # =============================
    # Automatic Disk Management
    # =============================
    # Uses /tmp (291GB partition) to bypass the 15GB Home Wall
    REAL_STORAGE="/tmp/hypercloud-data"
    LINK_PATH="$HOME/vms"
    
    mkdir -p "$REAL_STORAGE"
    
    if [ ! -L "$LINK_PATH" ]; then
        echo "[INFO] Redirecting storage to the large partition..."
        if [ -d "$LINK_PATH" ]; then
            mv "$LINK_PATH"/* "$REAL_STORAGE/" 2>/dev/null || true
            rm -rf "$LINK_PATH"
        fi
        ln -s "$REAL_STORAGE" "$LINK_PATH"
    fi
    
    VM_DIR="$LINK_PATH"
    IMG_FILE="$VM_DIR/ubuntu-cloud.img"
    SEED_FILE="$VM_DIR/seed.iso"
    MEMORY=256000
    CPUS=64
    SSH_PORT=24
    DISK_SIZE=20000G
    
    mkdir -p "$VM_DIR"
    cd "$VM_DIR"
    
    # =============================
    # VM Image Setup
    # =============================
    # Ensure image exists
if [ ! -f "$IMG_FILE" ]; then
    echo "[INFO] Downloading VM image..."
    wget -q https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img -O "$IMG_FILE"
    qemu-img resize "$IMG_FILE" "$DISK_SIZE"
fi

    # Ensure seed.iso exists
    if [ ! -f "$SEED_FILE" ]; then
        echo "[INFO] Creating cloud-init ISO..."

        cat > user-data <<EOF
    #cloud-config
    hostname: hypercloud
    ssh_pwauth: true
    chpasswd:
     list: |
        root:root
      expire: false
    EOF

        cat > meta-data <<EOF
    instance-id: iid-local01
    local-hostname: Host
    EOF

        genisoimage -output "$SEED_FILE" -volid cidata -joliet -rock user-data meta-data
    fi
    
    # IDENTITY: Intel Core i9-14900KS Emulation
    CPU_EMULATION="host,vendor=AuthenticAMD,+topoext,model-id=Intel Core i9-14900KS  @ 6.200GHz"
    
    # =============================
    # Start VM
    # =============================
    echo "[INFO] Starting Intel Core i9-14900KS VPS..."
    echo "[INFO] Storage Path: $(readlink -f $VM_DIR)"
    echo "[INFO] Access: ssh root@localhost -p $SSH_PORT (Password: root)"
    
    exec qemu-system-x86_64 \
        -m "$MEMORY" \
        -enable-kvm \
        -smp "$CPUS",sockets=1,cores=32,threads=2,maxcpus=64 \
        -cpu "$CPU_EMULATION" \
        -drive file="$IMG_FILE",format=qcow2,if=virtio \
        -drive file="$SEED_FILE",format=raw,if=virtio \
        -boot order=c \
        -device virtio-net-pci,netdev=n0 \
        -netdev user,id=n0,hostfwd=tcp::"$SSH_PORT"-:22 \
        -nographic -serial mon:stdio
